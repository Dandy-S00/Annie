# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_ADMIN_KEY=<admin-key-or-use-managed-identity>
AZURE_SEARCH_STATUTES_INDEX=tx-statutes
AZURE_SEARCH_CASELAW_INDEX=tx-caselaw
AZURE_SEARCH_OUTCOMES_INDEX=tx-outcomes

# Embedding model deployment (Azure OpenAI or Foundry model deployment)
AZURE_OPENAI_ENDPOINT=https://<your-foundry-resource>.openai.azure.com
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-10-21

# Foundry project (for the agent itself, not ingestion)
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.foundry.azure.com
FOUNDRY_MODEL_DEPLOYMENT=gpt-4.1

# Local paths to your downloaded corpora before ingestion
STATUTES_SOURCE_DIR=./data/statutes
CASELAW_SOURCE_DIR=./data/caselaw

# County docket lookup — fill in per-county endpoint/credentials as needed
DOCKET_LOOKUP_RATE_LIMIT_SECONDS=3

# State Bar of Texas directory (no official public API — see attorney_finder.py notes)
ATTORNEY_DIRECTORY_RATE_LIMIT_SECONDS=3
