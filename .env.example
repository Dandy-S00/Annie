# Azure Cognitive Search
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=replace-with-secret

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com
AZURE_OPENAI_KEY=replace-with-secret
AZURE_OPENAI_API_VERSION=2024-05-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# Application
ENVIRONMENT=production
PORT=8080
LOG_LEVEL=info
ENABLE_CACHING=true
# Comma-separated browser origins; leave empty when the API is server-to-server.
CORS_ALLOWED_ORIGINS=

# Host binding for docker-compose.production.yml
ANNIE_BIND_ADDRESS=127.0.0.1
ANNIE_PORT=8080
